{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "bun": "1.4.2",
    "node": "22"
  },
  "deploy": {
    "startCommand": "HOSTNAME=0.0.0.0 bun .next/standalone/server.js",
    "variables": {
      "HOSTNAME": "0.0.0.0",
      "NODE_ENV": "production"
    }
  }
}
